@page "/property-activator-validation"
@inherits PropertyActivatorValidationBase

<PageTitle>Property Activator Validation</PageTitle>

<h1>Property Activator Validation</h1>

<p>This page validates ordinary, keyed, inherited, and non-public [Inject] properties.</p>
<p><strong>Runtime phase:</strong> @(IsClientInteractive ? "Client interactive (WebAssembly)" : "Server prerender")</p>

<div class="table-responsive">
    <table id="injection-values-table" class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Case</th>
                <th>Source</th>
                <th>Value</th>
                <th>Key</th>
                <th>InstanceId</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Ordinary</td>
                <td>@OrdinaryProbe.Source</td>
                <td>@OrdinaryProbe.Value</td>
                <td>@(OrdinaryProbe.Key ?? "-")</td>
                <td>@OrdinaryProbe.InstanceId</td>
            </tr>
            <tr>
                <td>Keyed</td>
                <td>@KeyedProbe.Source</td>
                <td>@KeyedProbe.Value</td>
                <td>@(KeyedProbe.Key ?? "-")</td>
                <td>@KeyedProbe.InstanceId</td>
            </tr>
            <tr>
                <td>Inherited</td>
                <td>@InheritedProbe.Source</td>
                <td>@InheritedProbe.Value</td>
                <td>@(InheritedProbe.Key ?? "-")</td>
                <td>@InheritedProbe.InstanceId</td>
            </tr>
            <tr>
                <td>Non-public</td>
                <td>@NonPublicProbeDisplay.Source</td>
                <td>@NonPublicProbeDisplay.Value</td>
                <td>@(NonPublicProbeDisplay.Key ?? "-")</td>
                <td>@NonPublicProbeDisplay.InstanceId</td>
            </tr>
        </tbody>
    </table>
</div>

<section class="mt-3">
    <p>Scoped state count: @StateStore.Count</p>
    <button class="btn btn-primary btn-sm" @onclick="StateStore.Increment">Increment state</button>
</section>

<NoInjectionProbe />

<h2 class="h5 mt-4">Phase-tagged evidence</h2>
<p>This section captures values by phase so prerender-to-interactive handover is visible in one run.</p>
<div class="table-responsive">
    <table id="phase-evidence-table" class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Phase</th>
                <th>Activator</th>
                <th>Ordinary</th>
                <th>Keyed</th>
                <th>Inherited</th>
                <th>Non-public</th>
            </tr>
        </thead>
        <tbody>
            @if (PrerenderSnapshot is not null)
            {
                <tr>
                    <td>@PrerenderSnapshot.Phase</td>
                    <td>@PrerenderSnapshot.ActivatorMode</td>
                    <td>@PrerenderSnapshot.OrdinaryValue</td>
                    <td>@PrerenderSnapshot.KeyedValue</td>
                    <td>@PrerenderSnapshot.InheritedValue</td>
                    <td>@PrerenderSnapshot.NonPublicValue</td>
                </tr>
            }
            @if (CurrentSnapshot is not null)
            {
                <tr>
                    <td>@CurrentSnapshot.Phase</td>
                    <td>@CurrentSnapshot.ActivatorMode</td>
                    <td>@CurrentSnapshot.OrdinaryValue</td>
                    <td>@CurrentSnapshot.KeyedValue</td>
                    <td>@CurrentSnapshot.InheritedValue</td>
                    <td>@CurrentSnapshot.NonPublicValue</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5 mt-4">Activation log</h2>
<ul id="activation-log-list">
    @foreach (var entry in LogStore.Entries)
    {
        <li>@entry.Activator :: @entry.Component :: @entry.Property :: @entry.Value @(entry.Key is null ? string.Empty : $"(key={entry.Key})")</li>
    }
</ul>
